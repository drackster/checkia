# API Keys - Reemplaza con tus propias claves
OPENAI_API_KEY=tu-clave-openai-aqui
GEMINI_API_KEY=tu-clave-gemini-aqui

PORT=3000

# Prompts personalizados (opcional) - Si están vacíos se usa el prompt predeterminado
OPENAI_PROMPT=tu-prompt-personalizado-openai
GEMINI_PROMPT=tu-prompt-personalizado-gemini

# PayPal - Cambia PAYPAL_ENABLED a true para activar la pasarela de pagos
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=tu-client-id-de-paypal
PAYPAL_SECRET=tu-secret-de-paypal
PAYPAL_AMOUNT=1.00
PAYPAL_CURRENCY=USD
PAYPAL_MODE=sandbox
